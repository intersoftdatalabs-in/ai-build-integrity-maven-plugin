# .envrc — loads GitHub & Copilot tokens from `pass`
# Safe to commit: contains no secrets, only `pass` paths.
# Optional: use a repo-local password store by uncommenting the next line
# export PASSWORD_STORE_DIR="$PWD/.password-store"

load_pass_tokens() {
  # token names to load from pass (final path: github/tokens/intersoft/<NAME>)
  for name in GITHUB_TOKEN COPILOT_GITHUB_TOKEN; do
    pass_path="github/intersoft/${name}"
    if pass show "$pass_path" >/dev/null 2>&1; then
      # remove trailing newlines and export
      secret=$(pass show "$pass_path" | tr -d '\n')
      if [ -n "$secret" ]; then
        export "$name"="$secret"
      fi
    fi
  done
}

load_pass_tokens

export GPG_KEY_ID_INTERSOFT="CB96F96BE980BBE2"
export GPG_PASSPHRASE=""